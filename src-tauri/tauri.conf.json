{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Serien-Umbenenner",
  "version": "0.1.6",
  "identifier": "io.github.serien-umbenenner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Serien-Umbenenner",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 580,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.themoviedb.org; img-src 'self' data: https://image.tmdb.org; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Videos sicher umbenennen / Safely rename video files",
    "longDescription": "Lokales, sicheres Massen-Umbenennen mit Vorschau / Local, safe preview-first batch renaming.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBNTczMTk5QUZDRjNENkEKUldScVBjK3ZtVEZYYW05ZFJwcFlKOFNaS013ZStvUHM5Z0ZkZ28rMTVzc3h2b1JtN2pxVno0aEIK",
      "endpoints": [
        "https://github.com/ShadowEnemyx/serien-umbenenner/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
